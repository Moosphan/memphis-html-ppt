{
  "name": "memphis-html-ppt",
  "version": "0.1.0",
  "description": "Generate Memphis-style HTML presentation previews from Markdown files or web pages.",
  "type": "module",
  "license": "MIT",
  "author": "dorck",
  "scripts": {
    "preview": "node scripts/generate-preview.js",
    "export:premium": "node scripts/export-premium-html.js",
    "validate:premium": "node scripts/validate-premium-masters.js",
    "validate:preview": "node scripts/validate-generated-preview.js",
    "compare:phase": "node scripts/build-compare-before-after.js --template phase",
    "compare:risk": "node scripts/build-compare-before-after.js --template risk",
    "build": "node scripts/build-release.js",
    "publish:local": "node scripts/publish-local.js"
  },
  "engines": {
    "node": ">=18"
  }
}
